#!/usr/bin/env bash
set -euo pipefail

BASE_URL=https://storage.googleapis.com/cri-o/conmon-rs
SLUG=containers/conmon-rs
# The architectures are the packages of flake.nix. The build and publish jobs
# of the ci workflow and .github/release-files list them as well.
ARCHES=(amd64 arm64 ppc64le s390x)
ARCH=
COMMIT=
TAG=
NO_EXEC=
MARKER=
INSECURE=
OUTPUT=conmonrs
GITHUB_TOKEN=${GITHUB_TOKEN:-}
# How much older the commit of the latest-main.txt marker may be than the head
# of main without a warning, in seconds.
MAX_MARKER_LAG=86400

usage() {
    printf "Usage: %s [-o PATH] [-t SHA] [-l TAG] [-a ARCH] [-n] [-k] [-h]\n\n" "$(basename "$0")"
    echo "Possible arguments:"
    printf "  -o\tOutput path for the downloaded binary (defaults to './conmonrs')\n"
    printf "  -t\tFull length SHA to be used (defaults to the latest available main)\n"
    printf "  -l\tTag to be used\n"
    printf "  -a\tArchitecture to retrieve: %s (defaults to the local system)\n" "${ARCHES[*]}"
    printf "  -n\tDo not print the version after install, means don't execute the binary; the version is never printed for another architecture\n"
    printf "  -k\tInstall the binary even if no checksum got published for it (insecure, only without cosign)\n"
    printf "  -h\tShow this help message\n"
}

# The architecture of the local system, empty for an unsupported one.
local_arch() {
    case $(uname -m) in
    x86_64) echo amd64 ;;
    aarch64) echo arm64 ;;
    ppc64le | s390x) uname -m ;;
    esac
}

parse_args() {
    echo "Welcome to the conmon-rs install script!"

    while getopts 'a:hkl:no:t:' OPTION; do
        case "$OPTION" in
        a)
            ARCH="$OPTARG"
            echo "Using architecture: $ARCH"
            ;;
        k)
            INSECURE=1
            ;;
        l)
            TAG="$OPTARG"
            echo "Using tag: $TAG"
            ;;
        n)
            NO_EXEC=1
            ;;
        o)
            OUTPUT="$OPTARG"
            echo "Using output path: $OUTPUT"
            ;;
        t)
            COMMIT="$OPTARG"
            echo "Using commit: $COMMIT"
            ;;
        h)
            usage
            exit 0
            ;;
        ?)
            usage
            exit 1
            ;;
        esac
    done

    if [[ $ARCH == "" ]]; then
        ARCH=$(local_arch)
        if [[ $ARCH == "" ]]; then
            echo "Unsupported local architecture: $(uname -m)"
            exit 1
        fi
        echo "No architecture provided, using: $ARCH"
    elif [[ " ${ARCHES[*]} " != *" $ARCH "* ]]; then
        echo "Unsupported architecture: $ARCH, use one of: ${ARCHES[*]}"
        exit 1
    fi

    if [[ $TAG != "" && $COMMIT != "" ]]; then
        echo "Use either -t or -l, not both"
        exit 1
    fi
}

verify_requirements() {
    CMDS=(curl)
    # Only resolving a tag needs the GitHub API, the check of the latest commit
    # of main gets skipped without jq.
    if [[ $TAG != "" ]]; then
        CMDS+=(jq)
    fi
    if ! command -v cosign >/dev/null; then
        CMDS+=(sha256sum)
    fi
    echo "Checking if all commands are available: ${CMDS[*]}"
    for CMD in "${CMDS[@]}"; do
        if ! command -v "$CMD" >/dev/null; then
            echo "Command $CMD not available but required"
            exit 1
        fi
    done
}

curl_retry() {
    curl -sSfL --retry 5 --retry-delay 3 "$@"
}

# Prints the response of a GitHub API request, or why it failed. Returns 2 if
# the API does not know the object, 1 on other errors, like the rate limit.
github_api() {
    # --fail keeps the bodies of retried errors out of the response.
    local args=(-fsL --retry 5 --retry-delay 3 --retry-max-time 30 -w '\n%{http_code}')
    if [[ $GITHUB_TOKEN != "" ]]; then
        args+=(--header "Authorization: Bearer $GITHUB_TOKEN")
    fi
    local response
    response=$(curl "${args[@]}" "https://api.github.com/repos/$SLUG/$1") || true
    local status=${response##*$'\n'}
    if [[ $status == 200 ]]; then
        printf '%s\n' "${response%$'\n'*}"
        return
    fi
    case $status in
    404 | 422)
        echo "HTTP $status"
        return 2
        ;;
    403 | 429) echo "HTTP $status, probably its rate limit, which GITHUB_TOKEN raises" ;;
    000) echo "no response" ;;
    *) echo "HTTP $status" ;;
    esac
    return 1
}

# Anyone who can write to the bucket could point the marker to a commit which
# is not on main anymore, or back to an older one, whose binaries still have
# valid signatures. Fail for a commit which is not on main. Only warn if it is
# more than MAX_MARKER_LAG older than the head of main, a new head after a quiet
# day, whose binaries take a while, or a failing publish job cause that as
# well. Without jq, or if the API fails, like because of its rate limit, only
# warn too.
check_marker() {
    if ! command -v jq >/dev/null; then
        echo "WARNING: jq not available, unable to check the latest commit against main" >&2
        return
    fi
    echo "Checking the latest commit against main"
    # With main as the base, the response lists no commits or files, and has
    # the head of main and the commit as its base and merge base.
    local compare rc=0
    compare=$(github_api "compare/main...$COMMIT") || rc=$?
    if ((rc == 2)); then
        echo "The latest commit $COMMIT is not a commit of $SLUG"
        exit 1
    elif ((rc != 0)); then
        echo "WARNING: unable to check the latest commit against main, the GitHub API failed: $compare" >&2
        return
    fi
    case $(jq -r .status <<<"$compare") in
    identical) return ;;
    behind) ;;
    *)
        echo "The latest commit $COMMIT is not on main"
        exit 1
        ;;
    esac
    local lag
    lag=$(jq -r '(.base_commit.commit.committer.date | fromdateiso8601) - (.merge_base_commit.commit.committer.date | fromdateiso8601)' <<<"$compare")
    if ((lag > MAX_MARKER_LAG)); then
        echo "WARNING: the latest commit $COMMIT is $((lag / 3600)) hours older than the head of main: the binaries of the newer commits are not published yet or failed to publish, their tests failed, or the bucket points to an old commit" >&2
    fi
}

# Prints the response of a GitHub API request about TAG, exits if it fails.
tag_api() {
    local response rc=0
    response=$(github_api "$1") || rc=$?
    if ((rc == 2)); then
        echo "Tag $TAG not found in $SLUG" >&2
        exit 1
    elif ((rc != 0)); then
        echo "Unable to resolve tag $TAG, the GitHub API failed: $response" >&2
        exit 1
    fi
    printf '%s\n' "$response"
}

resolve_commit() {
    if [[ $TAG != "" ]]; then
        echo "Getting commit from tag"
        # The singular ref endpoint only matches the exact tag, the plural one
        # would return all tags starting with it.
        TAG_JSON=$(tag_api "git/ref/tags/$TAG")
        TAG_OBJ_TYPE=$(echo "$TAG_JSON" | jq -r .object.type)
        TAG_OBJ_SHA=$(echo "$TAG_JSON" | jq -r .object.sha)
        if [[ "$TAG_OBJ_TYPE" == "tag" ]]; then
            # Annotated tag: dereference to get the commit SHA
            COMMIT=$(tag_api "git/tags/$TAG_OBJ_SHA" | jq -r .object.sha)
        else
            COMMIT=$TAG_OBJ_SHA
        fi
    elif [[ $COMMIT == "" ]]; then
        echo "Getting latest commit on main"
        COMMIT=$(curl_retry "$BASE_URL/latest-main.txt?ts=$(date +%s)")
        MARKER=1
    fi

    # The signature gets checked against the commit, which has to be a full
    # SHA for that.
    if [[ ! $COMMIT =~ ^[0-9a-f]{40}$ ]]; then
        echo "Not a full length commit SHA: $COMMIT"
        exit 1
    fi
    if [[ $MARKER != "" ]]; then
        check_marker
    fi
    echo "Found commit: $COMMIT"
}

# The signature binds the binary to a ci run of the commit on main, so neither
# a binary of another commit nor one built elsewhere passes.
verify_signature() {
    echo "Found cosign, verifying binary signature"
    curl_retry "$BASE_URL/$COMMIT/conmonrs.$ARCH.bundle" -o "conmonrs.$ARCH.bundle"
    GIT_REF=refs/heads/main
    # The publish-static workflow signs the commits whose binaries have
    # attestations, the ci workflow signed the older ones. The ci workflow
    # runs both.
    local status workflow
    status=$(curl -sSL --retry 5 --retry-delay 3 -o /dev/null -w '%{http_code}' -I \
        "$BASE_URL/$COMMIT/conmonrs.$ARCH.intoto.jsonl")
    case $status in
    200) workflow=publish-static.yml ;;
    404) workflow=ci.yml ;;
    *)
        echo "Unable to check for the attestations of commit $COMMIT: HTTP $status"
        exit 1
        ;;
    esac
    echo "Expecting the signature of the $workflow workflow"
    cosign verify-blob "conmonrs.$ARCH" \
        --certificate-identity "https://github.com/$SLUG/.github/workflows/$workflow@$GIT_REF" \
        --certificate-oidc-issuer https://token.actions.githubusercontent.com \
        --certificate-github-workflow-name ci \
        --certificate-github-workflow-repository "$SLUG" \
        --certificate-github-workflow-ref "$GIT_REF" \
        --certificate-github-workflow-sha "$COMMIT" \
        --bundle "conmonrs.$ARCH.bundle"
}

# A checksum only shows that the download is complete, not who built it.
verify_checksum() {
    echo "No cosign found, verifying the checksum only"
    # The checksums of a release come from GitHub, not from the bucket.
    if [[ $TAG != "" ]] &&
        curl_retry "https://github.com/$SLUG/releases/download/$TAG/sha256sums.txt" -o sha256sums.txt 2>/dev/null; then
        echo "Using the checksums of release $TAG"
        if ! grep -E "^[0-9a-f]{64}  conmonrs\.$ARCH\$" sha256sums.txt >"conmonrs.$ARCH.sha256"; then
            echo "Release $TAG has no checksum for conmonrs.$ARCH"
            exit 1
        fi
    # Older commits have no checksum file.
    elif ! curl_retry "$BASE_URL/$COMMIT/conmonrs.$ARCH.sha256" -o "conmonrs.$ARCH.sha256" 2>/dev/null; then
        if [[ $INSECURE == "" ]]; then
            echo "No checksum published for commit $COMMIT, install cosign or use -k to skip the verification"
            exit 1
        fi
        echo "WARNING: no checksum published for this commit, the binary is not verified" >&2
        return
    fi
    sha256sum -c "conmonrs.$ARCH.sha256"
}

# Only the binaries of releases after v1.1.1 and of newer commits on main have
# provenance attestations.
print_verify_hint() {
    if [[ $TAG == "" ]]; then
        echo "Install cosign to verify the signature, or for commits after v1.1.1 verify the provenance with:"
    elif [[ $TAG =~ ^v([0-9]+)\.([0-9]+)\.([0-9]+) ]] &&
        ((BASH_REMATCH[1] * 1000000 + BASH_REMATCH[2] * 1000 + BASH_REMATCH[3] > 1001001)); then
        echo "Install cosign to verify the signature, or verify the provenance with:"
    else
        echo "Install cosign to verify the signature"
        return
    fi
    echo "  gh attestation verify $OUTPUT --repo $SLUG --signer-workflow $SLUG/.github/workflows/publish-static.yml --source-ref refs/heads/main --source-digest $COMMIT"
}

download_binary() {
    mkdir -p "$(dirname "$OUTPUT")"
    TMPDIR=$(mktemp -d)
    trap 'rm -rf "$TMPDIR"' EXIT
    pushd "$TMPDIR" >/dev/null

    curl_retry "$BASE_URL/$COMMIT/conmonrs.$ARCH" -o "conmonrs.$ARCH"
    if command -v cosign >/dev/null; then
        verify_signature
    else
        verify_checksum
        print_verify_hint
    fi

    popd >/dev/null
    mv "$TMPDIR/conmonrs.$ARCH" "$OUTPUT"
    chmod +x "$OUTPUT"
    printf "Installed binary into: %s\n" "$OUTPUT"

    # The binary of another architecture does not run here.
    if [[ $NO_EXEC == "" ]]; then
        if [[ $ARCH == "$(local_arch)" ]]; then
            "$(realpath "$OUTPUT")" -v
        else
            echo "Not running the $ARCH binary on this $(uname -m) system"
        fi
    fi
}

parse_args "$@"
verify_requirements
resolve_commit
download_binary
