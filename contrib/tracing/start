#!/usr/bin/env bash
set -uo pipefail

DIR=$(dirname "${BASH_SOURCE[0]}")

# CONTAINER_RUNTIME and JAEGER_CTR.
# shellcheck source=env
source "$DIR"/env

# A container of an earlier run would keep the name taken.
"$DIR"/stop

JAEGER_IMG="cr.jaegertracing.io/jaegertracing/jaeger:2.22.0"

echo "Starting $JAEGER_CTR"
"$CONTAINER_RUNTIME" run -d --rm --network host --name "$JAEGER_CTR" "$JAEGER_IMG"

# The OTLP gRPC port the server exports its spans to.
PORT=4317
MAX_CNT=100
for ((i = 0; i <= "$MAX_CNT"; i++)); do
    if (exec 3<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null; then
        break
    fi

    if [[ $i == "$MAX_CNT" ]]; then
        echo "Giving up"
        exit 1
    fi

    echo "Waiting for OTLP port $PORT to listen… ($i)"
    sleep 3
done

echo "Everything is ready"
