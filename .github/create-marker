#!/usr/bin/env bash
set -euo pipefail

# Writes the latest-X.txt marker of the checked out commit into the current
# directory, which the publish-marker action uploads to the bucket. A branch
# gets latest-BRANCH.txt with the commit, a tag vX.Y.Z gets latest-X.Y.txt with
# the tag. Runs finish in any order, so the marker only moves forward: no
# marker gets written if the one of the bucket already points to a newer
# commit of the branch or a newer release. Only a missing marker counts as
# none, any other error to read it fails, an older run could move it back
# otherwise. Sets forward in GITHUB_OUTPUT to whether the marker got written.
BASE_URL=https://storage.googleapis.com/cri-o/conmon-rs

MARKER=$(git rev-parse --abbrev-ref HEAD)
VERSION=$(git rev-parse HEAD)
TAG=
# A detached HEAD is the checkout of a tag, the one of the run if more than
# one points to the commit.
if [[ $MARKER == HEAD ]]; then
    # The marker is the major.minor version, its content the tag.
    if [[ ${GITHUB_REF_TYPE:-} == tag ]]; then
        VERSION=$GITHUB_REF_NAME
    else
        VERSION=$(git describe --tags --exact-match)
    fi
    if [[ ! $VERSION =~ ^v([0-9]+\.[0-9]+)\. ]]; then
        echo "Tag $VERSION does not look like vX.Y.Z" >&2
        exit 1
    fi
    MARKER=${BASH_REMATCH[1]}
    TAG=$VERSION
elif [[ $(git rev-parse --is-shallow-repository) == true ]]; then
    echo "The marker of a branch needs the full history to compare the commits" >&2
    exit 1
fi
FILE=latest-$MARKER.txt

# The timestamp keeps caches from serving an old marker. Without --fail, a
# missing marker is no error to retry, transient errors of the server and of
# the connection are. Only a missing marker counts as none. Any other status,
# or a failed or incomplete transfer, fails: an empty or truncated marker
# would let an older run move it back.
TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT
RC=0
STATUS=$(curl -sSL --retry 5 --retry-delay 3 --retry-all-errors -o "$TMP" -w '%{http_code}' \
    "$BASE_URL/$FILE?ts=$(date +%s)") || RC=$?
CURRENT=
if [[ $STATUS == 404 ]]; then
    echo "The bucket has no $FILE yet"
elif [[ $RC != 0 || $STATUS != 200 ]]; then
    echo "Unable to read $BASE_URL/$FILE: HTTP $STATUS, curl exit code $RC" >&2
    exit 1
else
    CURRENT=$(<"$TMP")
    # The marker of a tag names a release, the one of a branch a commit. One
    # which names something else gets fixed by hand rather than replaced,
    # this run cannot tell whether it is newer.
    if [[ -n $TAG && ! $CURRENT =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
        [[ -z $TAG && ! $CURRENT =~ ^[0-9a-f]{40}$ ]]; then
        echo "$BASE_URL/$FILE names neither a release nor a commit: $CURRENT" >&2
        exit 1
    fi
fi

# A commit which is not part of the history, like after a force push, gets
# replaced.
FORWARD=true
if [[ -n $TAG ]]; then
    if [[ -n $CURRENT ]] &&
        [[ $(printf '%s\n' "$CURRENT" "$TAG" | sort -V | tail -1) != "$TAG" ]]; then
        FORWARD=false
    fi
elif [[ -n $CURRENT ]] &&
    git cat-file -e "$CURRENT^{commit}" 2>/dev/null &&
    ! git merge-base --is-ancestor "$CURRENT" "$VERSION"; then
    FORWARD=false
fi

if [[ $FORWARD == true ]]; then
    echo "$VERSION" >"$FILE"
    echo "Pointing $FILE from ${CURRENT:-nothing} to $VERSION"
else
    echo "$FILE already points to the newer $CURRENT"
fi
if [[ -n ${GITHUB_OUTPUT:-} ]]; then
    echo "forward=$FORWARD" >>"$GITHUB_OUTPUT"
fi
