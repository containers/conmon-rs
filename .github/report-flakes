#!/usr/bin/env bash
set -euo pipefail

# List the tests of a report which passed, but only after more than one
# attempt: a ginkgo JSON report, where --flake-attempts lets them pass, or a
# JUnit report of nextest, where retries do. Both would hide them otherwise.
# Tests which failed on every attempt fail the run anyway and are left out.
#
# The ginkgo report only covers the specs, not the plain Go tests of the
# pkg/client package, which ginkgo runs alongside the suite without retries.
# Given LOG, the output of ginkgo, the failed ones get listed as well, the
# output of the specs buries them otherwise.
REPORT=${1:?usage: $0 REPORT [LOG]}
LOG=${2:-}

# Print one line per flaky test, with line breaks replaced by spaces.
flakes() {
    case $REPORT in
    *.xml)
        # nextest records every failed attempt of a test which passed in the
        # end as a flakyFailure, or a flakyError if the test could not run or
        # leaked handles.
        python3 -I - "$REPORT" <<'EOF'
import sys
import xml.etree.ElementTree as ET

for case in ET.parse(sys.argv[1]).iter("testcase"):
    retries = len(case.findall("flakyFailure")) + len(case.findall("flakyError"))
    if retries and case.find("failure") is None and case.find("error") is None:
        name = f"{case.get('classname')} {case.get('name')}"
        print(f"passed after {retries + 1} attempts: {' '.join(name.split())}")
EOF
        ;;
    *)
        jq -r '
            .[].SpecReports // [] | .[] |
            select(.State == "passed" and .NumAttempts > 1) |
            "passed after \(.NumAttempts) attempts: \((.ContainerHierarchyTexts // []) + [.LeafNodeText] | join(" "))" |
            gsub("[\r\n]"; " ")
        ' "$REPORT"
        ;;
    esac
}

# The Go test which runs the specs, it fails with them, which the report
# covers already.
SPECS_TEST=TestConmonClient

# Print one line per failed plain Go test of the log, a failed subtest
# after its parent. Only the exact lines of the testing package count, the
# output of the specs gets printed as it is.
failures() {
    if [[ $LOG == "" ]]; then
        return
    fi
    if [[ ! -f $LOG ]]; then
        echo "No log found at $LOG" >&2
        return
    fi
    sed -nE \
        -e "/^--- FAIL: $SPECS_TEST \\(/d" \
        -e 's/^( {4})*--- FAIL: ([^[:space:]]+) \([0-9]+\.[0-9]+s\)$/\2/p' \
        "$LOG"
}

# Report the lines with the title as warnings and in the step summary under
# the heading.
report() {
    local TITLE=$1 HEADING=$2 LINES=$3
    # Workflow commands need the % escaped.
    while IFS= read -r LINE; do
        echo "::warning title=$TITLE::${LINE//%/%25}"
    done <<<"$LINES"

    if [[ ${GITHUB_STEP_SUMMARY:-} != "" ]]; then
        local SUMMARY="### $HEADING"$'\n'
        while IFS= read -r LINE; do
            SUMMARY+=$'\n'"- $LINE"
        done <<<"$LINES"
        echo "$SUMMARY" >>"$GITHUB_STEP_SUMMARY"
    fi
}

if [[ ! -f $REPORT ]]; then
    echo "No report found at $REPORT"
else
    FLAKES=$(flakes)
    if [[ $FLAKES == "" ]]; then
        echo "No test needed a retry"
    else
        report "Flaky test" "Tests which needed retries" "$FLAKES"
    fi
fi

FAILURES=$(failures)
if [[ $FAILURES != "" ]]; then
    report "Failed test" "Go tests which failed" "$FAILURES"
fi
