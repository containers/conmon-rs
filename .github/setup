#!/usr/bin/env bash
set -euox pipefail

main() {
    prepare_system

    install_critest
    install_crio
}

curl_retry() {
    curl -sSfL --retry 5 --retry-delay 3 "$@"
}

prepare_system() {
    sudo systemctl stop docker
    sudo ufw disable

    # enable necessary kernel modules
    sudo modprobe br_netfilter
    sudo sysctl -p /etc/sysctl.conf
    sudo ip6tables --list >/dev/null

    # enable necessary sysctls
    sudo sysctl -w net.ipv4.conf.all.route_localnet=1
    sudo sysctl -w net.ipv4.ip_forward=1

    # needed for crictl test
    sudo sysctl -w net.bridge.bridge-nf-call-iptables=1
    sudo iptables -t nat -I POSTROUTING -s 127.0.0.0/8 ! -d 127.0.0.0/8 -j MASQUERADE

    if ! grep -q containers /etc/subuid; then
        echo "containers:100000:65536" | sudo tee -a /etc/subuid
    fi
    if ! grep -q containers /etc/subgid; then
        echo "containers:100000:65536" | sudo tee -a /etc/subgid
    fi

    printf "RateLimitInterval=0\nRateLimitBurst=0\n" | sudo tee /etc/systemd/journald.conf
    sudo systemctl restart systemd-journald
}

install_crio() {
    # Pinned to a commit, the script runs as root, see dependencies.yaml. It
    # has to verify the signatures of the bundle with the cosign of the job,
    # which sudo would drop from the PATH. Root only gets the directory of
    # cosign in front of the standard PATH, not the user writable ones of
    # the runner.
    PACKAGING_COMMIT=4196859aba59fa6dbe0e2b0e0b1a8f66ede832cd
    local cosign
    cosign=$(command -v cosign) || {
        echo "::error::cosign is required to verify the CRI-O bundle" >&2
        exit 1
    }
    curl_retry "https://raw.githubusercontent.com/cri-o/packaging/$PACKAGING_COMMIT/get" |
        sudo env PATH="${cosign%/*}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" bash -s -- -v

    cat <<EOT | sudo tee /etc/crio/crio.conf.d/10-crun.conf
[crio.runtime]
log_level = "debug"
default_runtime = "crun"

[crio.runtime.runtimes.crun]
runtime_path = "/usr/libexec/crio/crun"
runtime_type = "pod"
monitor_path = "/usr/libexec/crio/conmonrs"
# Exec and attach through the streaming server of conmon-rs, which critest
# only reaches over WebSocket. crio status config does not show it.
stream_websockets = ${STREAM_WEBSOCKETS:-false}

# critest verifies the pod sandbox metrics since cri-tools v1.37.0, which
# CRI-O only serves when they are enabled.
[crio.stats]
included_pod_metrics = ["all"]
EOT

    sudo mv /etc/cni/net.d/10-crio-bridge.conflist.disabled \
        /etc/cni/net.d/10-crio-bridge.conflist

    sudo systemctl enable --now crio.service

    # Validate if the correct config is being loaded. grep -q would stop
    # reading at the first match, which fails the pipe with SIGPIPE if crio
    # writes more.
    sudo crio status config | grep 'default_runtime = "crun"' >/dev/null
    sudo crio status config | grep 'runtime_type = "pod"' >/dev/null
}

install_critest() {
    # cri-tools publishes no signatures, the checksum is pinned with the
    # version instead of read from the release.
    CRI_TOOLS_VERSION=v1.37.0
    CRITEST_SHA256=e39780b83deac72e3d70599a6641f4db7661b63ebe15aa6d9f6d46dde06a4c05
    TARBALL=critest-$CRI_TOOLS_VERSION-linux-amd64.tar.gz

    curl_retry "https://github.com/kubernetes-sigs/cri-tools/releases/download/$CRI_TOOLS_VERSION/$TARBALL" -o "$TARBALL"
    echo "$CRITEST_SHA256  $TARBALL" | sha256sum -c
    sudo tar xzf "$TARBALL" -C /usr/local/bin critest
    rm "$TARBALL"
    sudo critest --version
}

main "$@"
