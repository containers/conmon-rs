#!/usr/bin/env bash
set -euo pipefail

# Compare the layout of the Cap'n Proto schema, which `capnp compile -ocapnp`
# prints with the slot of every field (`# ptr[N]` or `# bits[a, b)`), with the
# committed one. Clients and servers of different versions only understand
# each other as long as no field, method, enumerant or ID moves or changes its
# type, like when v1.0.0 turned metadataOld from Data into Void and freed its
# pointer slot. Every line of the committed layout has to stay in its struct,
# interface or enum, new ones may be added. The sizes of the structs, which
# grow with new fields, are left out of that comparison.
#
# The wire format does not carry the names of fields, methods and enumerants,
# renaming one with its ordinal and type unchanged is how a field gets
# retired. A renamed struct, interface or enum changes its ID, which counts as
# a break. So does a renamed group or method parameter, which keeps the wire
# format, but changes the scope of its members or the line of the method.
#
# Renames and additions have to be committed as well, so that they are
# guarded from then on: `make update-schema-layout` writes the new layout. Run
# it for a deliberate break as well, which needs a new major version. The
# layout depends on the version of capnp, the Makefile uses the one of
# flake.lock.
#
# Usage: verify-schema-layout [--update] COMMITTED GENERATED

UPDATE=false
if [[ ${1:-} == --update ]]; then
    UPDATE=true
    shift
fi
COMMITTED=${1:?usage: $0 [--update] COMMITTED GENERATED}
GENERATED=${2:?usage: $0 [--update] COMMITTED GENERATED}

# Print the generated layout with the header of the committed one.
layout() {
    echo "# The layout of conmon.capnp, generated by make update-schema-layout. Do"
    echo "# not edit it, .github/verify-schema-layout compares it with the schema."
    cat "$GENERATED"
}

# Prefix every line with the declarations it is nested in and a tab, without
# the sizes of the structs, so that a field which moves to another struct
# counts as removed. Drop the closing braces and the comments, like the
# header and the path of the schema. A union opens a scope as well, its line
# ends with the bits of its tag: `union {  # tag bits [32, 48)`.
normalize() {
    awk '
        /^#/ { next }
        {
            sub(/^ +/, "")
            sub(/ +# [0-9]+ bytes, [0-9]+ ptrs$/, "")
        }
        $0 == "}" { depth--; next }
        {
            path = ""
            for (i = 1; i <= depth; i++) {
                path = path scope[i] " > "
            }
            print path "\t" $0
        }
        / \{( +#.*)?$/ { scope[++depth] = $0 }
    ' "$1" | LC_ALL=C sort
}

# Drop the name of every field, method and enumerant, the members with a
# decimal ordinal.
anonymize() {
    sed -E 's/\t[A-Za-z_][A-Za-z0-9_]* (@[0-9]+[ ;])/\t\1/'
}

if [[ ! -s $GENERATED ]]; then
    echo "The layout $GENERATED is empty" >&2
    exit 1
fi

if [[ $UPDATE == true ]]; then
    layout >"$COMMITTED"
    exit
fi

if [[ ! -s $COMMITTED ]]; then
    echo "The layout $COMMITTED is empty, run make update-schema-layout." >&2
    exit 1
fi

# A line of the committed layout which is missing from the generated one is
# a rename if the generated one has it without the name.
NEW=$(normalize "$GENERATED")
ANONYMOUS=$(anonymize <<<"$NEW")
BROKEN=()
while IFS= read -r LINE; do
    if ! grep -Fxq -- "$(anonymize <<<"$LINE")" <<<"$ANONYMOUS"; then
        BROKEN+=("${LINE/$'\t'/}")
    fi
done < <(LC_ALL=C comm -23 <(normalize "$COMMITTED") - <<<"$NEW")

if ((${#BROKEN[@]} != 0)); then
    echo "The schema moved, changed the type or ID of or removed these parts of the layout in $COMMITTED, which breaks the wire compatibility with older clients and servers:" >&2
    printf '%s\n' "${BROKEN[@]}" >&2
    echo "Retire a field by renaming it with its type unchanged and add a new one instead. For a deliberate break, which needs a new major version, run make update-schema-layout." >&2
    exit 1
fi

if ! diff -u "$COMMITTED" <(layout) >&2; then
    echo "$COMMITTED differs from the generated layout by the renames, additions or reordering above, which keep the wire compatibility. Run make update-schema-layout and commit the result, so that they are guarded from then on." >&2
    exit 1
fi
