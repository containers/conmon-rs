#!/usr/bin/env bash
set -euo pipefail

# Install crun from GitHub releases, the integration tests run it. The
# release binaries are signed with one of the keys of crun.keyring, a copy of
# the keyring of the crun repository, whose primary keys have these
# fingerprints (Giuseppe Scrivano and Kir Kolyshkin).
CRUN_VERSION=1.31
FINGERPRINTS='AC404C1C0BF735C63FF4D562263D6DF2E163E1EA|C2428CD75720FACDCF76B6EA17DE5ECB75A1100E'

case $(uname -m) in
x86_64) ARCH=amd64 ;;
aarch64) ARCH=arm64 ;;
*)
    echo "Unsupported architecture $(uname -m)" >&2
    exit 1
    ;;
esac
URL=https://github.com/containers/crun/releases/download/$CRUN_VERSION/crun-$CRUN_VERSION-linux-$ARCH

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT
# With retries, and through the API of GitHub if GH_TOKEN is set.
DOWNLOAD=$(dirname "$0")/download-release
"$DOWNLOAD" "$URL" "$TMPDIR/crun"
"$DOWNLOAD" "$URL.asc" "$TMPDIR/crun.asc"

export GNUPGHOME=$TMPDIR/gnupg
mkdir -m 700 "$GNUPGHOME"
gpg --batch --quiet --import "$(dirname "$0")/crun.keyring"
# grep reads all status lines, grep -q would stop at the match and fail the
# pipe with SIGPIPE if gpg writes more after it.
if ! gpg --batch --status-fd 1 --verify "$TMPDIR/crun.asc" "$TMPDIR/crun" 2>/dev/null |
    grep -E "^\[GNUPG:\] VALIDSIG .* ($FINGERPRINTS)\$" >/dev/null; then
    echo "Invalid signature of crun $CRUN_VERSION" >&2
    exit 1
fi

sudo install -m 755 "$TMPDIR/crun" /usr/bin/crun
crun --version
